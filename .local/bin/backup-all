#!/usr/bin/env bash
set -euo pipefail

age_key_arg=""

usage() {
  echo "Usage: backup-all [--path-to-age-key=<pass-path>] <target_1> <target_2>..." >&2
}

step() {
  echo
  echo "[$1/8] $2"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --path-to-age-key=*)
      age_key_arg="$1"
      shift
      ;;
    --path-to-age-key)
      echo "Error: use --path-to-age-key=<pass-path>" >&2
      exit 1
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -lt 1 ]; then
  usage
  exit 1
fi

targets=()

for target in "$@"; do
  if [ ! -e "$target" ]; then
    echo "Error: target not found: $target" >&2
    exit 1
  fi

  targets+=("$(realpath "$target")")
done

today="$(date +%y%m%d)"

pcloud_root="$HOME/pCloudDrive/Backup"
backup_name="backup-$today"
local_backup="/tmp/$backup_name"
final_backup="$pcloud_root/$backup_name"
info_file="$local_backup/INFO.md"
checksum_file="$local_backup/SHA256SUMS.txt"
encrypt_script="$pcloud_root/encrypt-this.sh"

if [ ! -x "$encrypt_script" ]; then
  echo "Error: encrypt script not found or not executable: $encrypt_script" >&2
  exit 1
fi

if [ -e "$final_backup" ]; then
  echo "Error: final backup already exists: $final_backup" >&2
  exit 1
fi

if [ -e "$local_backup" ]; then
  echo "Error: local temporary backup already exists: $local_backup" >&2
  exit 1
fi

step 1 "Prepare local backup"
mkdir -p "$local_backup"
cd "$local_backup"
echo "Local:  $local_backup"
echo "Final:  $final_backup"

step 2 "Check available space"
df -h "$local_backup"

step 3 "Check backup size"
backup_size="$(du -sh "${targets[@]}")"
printf '%s\n' "$backup_size"

step 4 "Write INFO.md"
{
  echo "# Backup $today"
  echo
  echo "Created: $(date -Is)"
  echo "Host: $(hostname)"
  echo
  echo "## Source sizes"
  echo
  echo '```text'
  printf '%s\n' "$backup_size"
  echo '```'
  echo
  echo "## Source trees"
} > "$info_file"

for target in "${targets[@]}"; do
  echo "Indexing: $target"

  {
    echo
    echo "### $target"
    echo
    echo '```text'
    du -h --max-depth=3 "$target" | sort -h
    echo '```'
  } >> "$info_file"
done

step 5 "Create encrypted archives"
for target in "${targets[@]}"; do
  echo
  echo "Encrypting: $target"

  if [ -n "$age_key_arg" ]; then
    bash "$encrypt_script" "$age_key_arg" "$target"
  else
    bash "$encrypt_script" "$target"
  fi
done

step 6 "Create and verify checksums"
sha256sum ./*.tar.age | tee "$checksum_file"
sha256sum -c "$checksum_file"

{
  echo
  echo "## Encrypted archive SHA-256"
  echo
  echo '```text'
  cat "$checksum_file"
  echo '```'
} >> "$info_file"

echo
echo "Local backup content:"
ls -lh "$local_backup"

step 7 "Move backup to pCloud"
mkdir -p "$pcloud_root"
mv "$local_backup" "$final_backup"

step 8 "Check final backup folder"
cd "$final_backup"

echo "Final backup content:"
ls -lh "$final_backup"

echo
echo "Final backup content:"
ls -lh "$final_backup"

echo
echo "Done:"
echo "$final_backup"

echo
echo "Later, after pCloud has fully uploaded/synced this backup, verify integrity with:"
echo "cd \"$final_backup\" && sha256sum -c SHA256SUMS.txt"
echo "Note: this may take time and use disk, CPU, and network bandwidth."
