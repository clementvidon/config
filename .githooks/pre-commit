#!/bin/sh
# Reject commits with whitespace, layout, or configuration syntax errors.

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

# A commit exports repository-local variables such as GIT_INDEX_FILE. The
# checks create isolated Git repositories, which must discover their own state.
unset $(git rev-parse --local-env-vars)

git diff --cached --check
./scripts/check.sh --quick
