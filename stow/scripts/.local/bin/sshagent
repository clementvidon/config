#!/usr/bin/env bash
#
# Purpose: Reuse or start a persistent ssh-agent and print shell exports.

set -Eeuo pipefail

ENV_FILE="${SSH_AGENT_ENV_FILE:-$HOME/.ssh/agent-environment}"
ADD_IDENTITIES=true

usage() {
  cat <<'EOF'
Usage: sshagent [options]

Reuse a responsive agent from the current environment or the saved environment
file. Otherwise start one, optionally load default identities, and print shell
exports. Evaluate the output in the calling shell:

  eval "$(sshagent)"

Options:
      --no-add  Do not run ssh-add when a new agent is started
  -h, --help    Show this help
EOF
}

die() {
  printf '[ERROR] %s\n' "$*" >&2
  exit 1
}

agent_is_responsive() {
  local status

  [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] || return 1
  [[ -z "${SSH_AGENT_PID:-}" || "${SSH_AGENT_PID:-}" =~ ^[0-9]+$ ]] || return 1

  if SSH_AUTH_SOCK="$SSH_AUTH_SOCK" SSH_AGENT_PID="${SSH_AGENT_PID:-}" \
    ssh-add -l >/dev/null 2>&1; then
    return 0
  else
    status=$?
  fi

  [[ $status -eq 1 ]]
}

load_saved_environment() {
  local line value

  [[ -r "$ENV_FILE" ]] || return 1

  SSH_AUTH_SOCK=""
  SSH_AGENT_PID=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      SSH_AUTH_SOCK=*)
        value="${line#*=}"
        SSH_AUTH_SOCK="${value%%;*}"
        ;;
      SSH_AGENT_PID=*)
        value="${line#*=}"
        SSH_AGENT_PID="${value%%;*}"
        ;;
    esac
  done <"$ENV_FILE"

  agent_is_responsive
}

save_environment() {
  local environment_directory
  environment_directory="${ENV_FILE%/*}"
  [[ "$environment_directory" == "$ENV_FILE" ]] && environment_directory='.'

  mkdir -p -- "$environment_directory"
  umask 077
  {
    printf 'SSH_AUTH_SOCK=%s\n' "$SSH_AUTH_SOCK"
    printf 'SSH_AGENT_PID=%s\n' "${SSH_AGENT_PID:-}"
  } >"$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

start_agent() {
  local output

  output="$(ssh-agent -s)" || die 'Could not start ssh-agent'
  SSH_AUTH_SOCK="$(printf '%s\n' "$output" \
    | sed -n 's/^SSH_AUTH_SOCK=\([^;]*\);.*/\1/p')"
  SSH_AGENT_PID="$(printf '%s\n' "$output" \
    | sed -n 's/^SSH_AGENT_PID=\([0-9][0-9]*\);.*/\1/p')"

  agent_is_responsive || die 'ssh-agent returned an invalid environment'
  save_environment

  if $ADD_IDENTITIES; then
    printf '[INFO] Loading default SSH identities\n' >&2
    if ! SSH_AUTH_SOCK="$SSH_AUTH_SOCK" SSH_AGENT_PID="$SSH_AGENT_PID" ssh-add </dev/tty; then
      printf '[WARN] No default SSH identity was loaded\n' >&2
    fi
  fi
}

print_environment() {
  printf 'export SSH_AUTH_SOCK=%q\n' "$SSH_AUTH_SOCK"
  if [[ -n "${SSH_AGENT_PID:-}" ]]; then
    printf 'export SSH_AGENT_PID=%q\n' "$SSH_AGENT_PID"
  else
    printf 'unset SSH_AGENT_PID\n'
  fi
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-add)
        ADD_IDENTITIES=false
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done

  command -v ssh-agent >/dev/null 2>&1 || die 'ssh-agent is not installed'
  command -v ssh-add >/dev/null 2>&1 || die 'ssh-add is not installed'

  if agent_is_responsive; then
    save_environment
  elif ! load_saved_environment; then
    printf '[INFO] Starting a new SSH agent\n' >&2
    start_agent
  fi

  print_environment
}

main "$@"
