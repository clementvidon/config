#!/usr/bin/env bash
#
# Purpose: Build, verify, and publish a set of encrypted path backups.

set -Eeuo pipefail

DESTINATION="${BACKUP_DESTINATION:-$HOME/pCloudDrive/Backup}"
AGE_KEY_PATH=""
ENCRYPT_COMMAND="${BACKUP_ENCRYPT_COMMAND:-encrypt-this}"
LOCAL_BACKUP=""
readonly STEP_COUNT=8

usage() {
  cat <<'EOF'
Usage: backup-all [options] FILE|DIRECTORY [FILE|DIRECTORY ...]

Create one verified age archive per source, generate an index and SHA-256
checksums, then atomically move the completed backup into a destination that
already exists. The default destination is ~/pCloudDrive/Backup.

Options:
  -d, --destination DIR            Existing backup destination
  -k, --path-to-age-key PASS_PATH  Use an age identity stored in pass
  -h, --help                       Show this help

Environment:
  BACKUP_DESTINATION      Override the default destination
  BACKUP_ENCRYPT_COMMAND  Override the encrypt-this executable
EOF
}

die() {
  printf '[ERROR] %s\n' "$*" >&2
  if [[ -n "$LOCAL_BACKUP" && -d "$LOCAL_BACKUP" ]]; then
    printf '[ERROR] Incomplete backup retained at: %s\n' "$LOCAL_BACKUP" >&2
  fi
  exit 1
}

step() {
  printf '\n[%s/%s] %s\n' "$1" "$STEP_COUNT" "$2"
}

absolute_path() {
  local path="$1"
  local directory base

  if [[ -d "$path" ]]; then
    (cd -- "$path" && pwd -P)
    return
  fi

  directory="${path%/*}"
  base="${path##*/}"
  [[ "$directory" == "$path" ]] && directory='.'
  [[ -z "$directory" ]] && directory='/'
  (
    cd -- "$directory"
    printf '%s/%s\n' "$(pwd -P)" "$base"
  )
}

iso_timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

write_checksums() {
  local output="$1"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum ./*.tar.age >"$output"
  else
    shasum -a 256 ./*.tar.age >"$output"
  fi
}

verify_checksums() {
  local checksum_file="$1"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -c "$checksum_file"
  else
    shasum -a 256 -c "$checksum_file"
  fi
}

main() {
  local today backup_name final_backup info_file checksum_file backup_size
  local target target_abs base previous_base
  local -a targets=()
  local -a basenames=()
  local -a key_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --destination)
        [[ $# -ge 2 ]] || die "$1 expects a directory"
        DESTINATION="$2"
        shift 2
        ;;
      --destination=*)
        DESTINATION="${1#*=}"
        [[ -n "$DESTINATION" ]] || die '--destination expects a directory'
        shift
        ;;
      -k | --path-to-age-key)
        [[ $# -ge 2 ]] || die "$1 expects a pass path"
        AGE_KEY_PATH="$2"
        shift 2
        ;;
      --path-to-age-key=*)
        AGE_KEY_PATH="${1#*=}"
        [[ -n "$AGE_KEY_PATH" ]] || die '--path-to-age-key expects a pass path'
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  [[ $# -gt 0 ]] || die 'At least one source is required'
  [[ -d "$DESTINATION" ]] || die "Destination does not exist: $DESTINATION"
  [[ -w "$DESTINATION" ]] || die "Destination is not writable: $DESTINATION"

  command -v "$ENCRYPT_COMMAND" >/dev/null 2>&1 \
    || die "Encryption command not found: $ENCRYPT_COMMAND"
  command -v du >/dev/null 2>&1 || die 'du is not installed'
  if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
    die 'sha256sum or shasum is required'
  fi

  for target in "$@"; do
    target="${target%/}"
    [[ -n "$target" ]] || target='/'
    [[ -e "$target" ]] || die "Source not found: $target"
    [[ -r "$target" ]] || die "Source not readable: $target"

    target_abs="$(absolute_path "$target")"
    [[ "$target_abs" != '/' ]] || die 'Refusing to back up the filesystem root'
    [[ "$target_abs" != *$'\n'* ]] || die 'Source paths must not contain newlines'
    base="$(basename -- "$target_abs")"

    for previous_base in "${basenames[@]}"; do
      [[ "$base" != "$previous_base" ]] \
        || die "Sources must have unique basenames; duplicate: $base"
    done

    basenames+=("$base")
    targets+=("$target_abs")
  done

  [[ -z "$AGE_KEY_PATH" ]] || key_args=(--path-to-age-key "$AGE_KEY_PATH")

  today="$(date +%y%m%d)"
  backup_name="backup-$today"
  final_backup="$(absolute_path "$DESTINATION")/$backup_name"
  [[ ! -e "$final_backup" && ! -L "$final_backup" ]] \
    || die "Final backup already exists: $final_backup"

  LOCAL_BACKUP="$(mktemp -d "${TMPDIR:-/tmp}/backup-all.XXXXXX")"
  info_file="$LOCAL_BACKUP/INFO.md"
  checksum_file="$LOCAL_BACKUP/SHA256SUMS.txt"

  step 1 'Prepare local backup'
  printf 'Local:  %s\nFinal:  %s\n' "$LOCAL_BACKUP" "$final_backup"

  step 2 'Check available space'
  df -h "$LOCAL_BACKUP"

  step 3 'Check source sizes'
  backup_size="$(du -sh "${targets[@]}")"
  printf '%s\n' "$backup_size"

  step 4 'Write INFO.md'
  {
    printf '# Backup %s\n\n' "$today"
    printf 'Created: %s\n' "$(iso_timestamp)"
    printf 'Host: %s\n\n' "$(hostname)"
    printf '## Source sizes\n\n```text\n%s\n```\n\n' "$backup_size"
    printf '## Source trees\n'
  } >"$info_file"

  for target in "${targets[@]}"; do
    printf 'Indexing: %s\n' "$target"
    {
      printf '\n### %s\n\n```text\n' "$target"
      du -h -d 3 "$target"
      printf '```\n'
    } >>"$info_file"
  done

  step 5 'Create and verify encrypted archives'
  (
    cd -- "$LOCAL_BACKUP"
    for target in "${targets[@]}"; do
      printf '\nEncrypting: %s\n' "$target"
      "$ENCRYPT_COMMAND" "${key_args[@]}" -- "$target"
    done
  )

  step 6 'Create and verify checksums'
  (
    cd -- "$LOCAL_BACKUP"
    write_checksums "${checksum_file##*/}"
    cat -- "${checksum_file##*/}"
    verify_checksums "${checksum_file##*/}"
  )

  {
    printf '\n## Encrypted archive SHA-256\n\n```text\n'
    cat -- "$checksum_file"
    printf '```\n'
  } >>"$info_file"

  printf '\nLocal backup content:\n'
  ls -lh -- "$LOCAL_BACKUP"

  step 7 'Move backup to destination'
  mv -- "$LOCAL_BACKUP" "$final_backup"
  LOCAL_BACKUP=""

  step 8 'Check final backup folder'
  printf 'Final backup content:\n'
  ls -lh -- "$final_backup"

  printf '\nDone:\n%s\n' "$final_backup"
  printf '\nAfter synchronization, verify integrity with:\n'
  printf '  cd %q && ' "$final_backup"
  if command -v sha256sum >/dev/null 2>&1; then
    printf 'sha256sum -c SHA256SUMS.txt\n'
  else
    printf 'shasum -a 256 -c SHA256SUMS.txt\n'
  fi
}

main "$@"
