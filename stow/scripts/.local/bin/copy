#!/usr/bin/env bash
#
# Purpose: Copy labeled file contents to the system clipboard.

set -Eeuo pipefail

IGNORE_FILE=""
OUTPUT_FILE=""

usage() {
  cat <<'EOF'
Usage: copy [options] FILE|DIR [FILE|DIR ...]

Copy file contents to the system clipboard. Directories are traversed
recursively; each file is preceded by its absolute path.

Options:
  -i, --ignore FILE  Read simple glob exclusions from FILE
  -h, --help         Show this help

Ignore patterns:
  name.ext       Match a basename at any depth
  path/name.ext  Match a path relative to each copied directory
  directory/     Match a directory at any depth
EOF
}

die() {
  printf '[ERROR] %s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ -n "$OUTPUT_FILE" && -f "$OUTPUT_FILE" ]]; then
    rm -f -- "$OUTPUT_FILE"
  fi
}

trap cleanup EXIT

copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  elif command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  else
    die 'No clipboard tool found (pbcopy, wl-copy, or xclip)'
  fi
}

absolute_path() {
  local path="$1"
  local directory base

  if [[ -d "$path" ]]; then
    (cd -- "$path" && pwd -P)
    return
  fi

  directory="${path%/*}"
  base="${path##*/}"
  [[ "$directory" == "$path" ]] && directory='.'
  [[ -z "$directory" ]] && directory='/'
  (
    cd -- "$directory"
    printf '%s/%s\n' "$(pwd -P)" "$base"
  )
}

is_ignored() {
  local relative="$1"
  local basename="${relative##*/}"
  local pattern dir_pattern

  [[ -n "$IGNORE_FILE" ]] || return 1

  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    pattern="${pattern%$'\r'}"
    [[ -z "$pattern" || "$pattern" == \#* ]] && continue
    pattern="${pattern#/}"

    if [[ "$pattern" == */ ]]; then
      dir_pattern="${pattern%/}"
      if [[ "$relative" == "$dir_pattern/"* ||
        "$relative" == */"$dir_pattern/"* ]]; then
        return 0
      fi
    elif [[ "$pattern" == */* ]]; then
      if [[ "$relative" == $pattern ]]; then
        return 0
      fi
    elif [[ "$basename" == $pattern ]]; then
      return 0
    fi
  done <"$IGNORE_FILE"

  return 1
}

copy_file() {
  local file="$1"
  local path
  path="$(absolute_path "$file")"

  printf '===== %s =====\n\n' "$path"
  cat -- "$file"
  printf '\n\n'
}

main() {
  local path root file relative
  local -a paths=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i | --ignore)
        [[ $# -ge 2 ]] || die "$1 expects a file"
        IGNORE_FILE="$2"
        shift 2
        ;;
      --ignore=*)
        IGNORE_FILE="${1#*=}"
        [[ -n "$IGNORE_FILE" ]] || die '--ignore expects a file'
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        paths+=("$@")
        break
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        paths+=("$1")
        shift
        ;;
    esac
  done

  [[ ${#paths[@]} -gt 0 ]] || die 'At least one file or directory is required'
  [[ -z "$IGNORE_FILE" || -r "$IGNORE_FILE" ]] \
    || die "Ignore file not found or not readable: $IGNORE_FILE"

  for path in "${paths[@]}"; do
    [[ -f "$path" || -d "$path" ]] || die "Not a file or directory: $path"
    [[ -r "$path" ]] || die "Not readable: $path"
  done

  OUTPUT_FILE="$(mktemp "${TMPDIR:-/tmp}/copy.XXXXXX")"

  for path in "${paths[@]}"; do
    if [[ -f "$path" ]]; then
      if ! is_ignored "${path##*/}"; then
        copy_file "$path" >>"$OUTPUT_FILE"
      fi
    else
      root="$(absolute_path "$path")"
      [[ "$root" == '/' ]] || root="${root%/}"

      while IFS= read -r -d '' file; do
        relative="${file#"$root"/}"
        if ! is_ignored "$relative"; then
          copy_file "$file" >>"$OUTPUT_FILE"
        fi
      done < <(find -H "$root" -type f -print0)
    fi
  done

  copy_to_clipboard <"$OUTPUT_FILE"
}

main "$@"
