#!/usr/bin/env bash
#
# Purpose: Estimate a gross daily and hourly rate from a monthly net target.

set -Eeuo pipefail

readonly WORKDAYS_PER_MONTH=15
readonly WORKHOURS_PER_DAY=8
readonly SOCIAL_CONTRIBUTIONS_PERCENT=22
readonly HEALTH_INSURANCE_EUR=50
readonly UNEMPLOYMENT_INSURANCE_EUR=90
readonly LIABILITY_INSURANCE_EUR=30
readonly OPERATING_COSTS_PERCENT=10

usage() {
  cat <<'EOF'
Usage: tjm [-h|--help] MONTHLY_NET_EUR

Estimate gross monthly, yearly, daily (TJM), and hourly (THM) amounts from a
monthly net income target. The assumptions are constants near the top of the
script and the result uses integer arithmetic.

Options:
  -h, --help  Show this help
EOF
}

die() {
  printf '[ERROR] %s\n' "$*" >&2
  exit 1
}

main() {
  if [[ $# -eq 1 && ("$1" == '-h' || "$1" == '--help') ]]; then
    usage
    exit 0
  fi

  [[ $# -eq 1 ]] || die 'Exactly one monthly net amount is required'
  [[ "$1" =~ ^[0-9]{1,9}$ ]] \
    || die 'The monthly net amount must be an integer from 0 to 999999999'

  local net_month=$((10#$1))
  local gross_month daily_rate hourly_rate gross_year net_year

  printf '%s + social contributions %s%%\n' "$net_month" "$SOCIAL_CONTRIBUTIONS_PERCENT"
  gross_month=$((net_month + net_month * SOCIAL_CONTRIBUTIONS_PERCENT / 100))

  printf '%s + health insurance %s EUR\n' "$gross_month" "$HEALTH_INSURANCE_EUR"
  gross_month=$((gross_month + HEALTH_INSURANCE_EUR))

  printf '%s + unemployment insurance %s EUR\n' "$gross_month" "$UNEMPLOYMENT_INSURANCE_EUR"
  gross_month=$((gross_month + UNEMPLOYMENT_INSURANCE_EUR))

  printf '%s + professional liability insurance %s EUR\n' \
    "$gross_month" "$LIABILITY_INSURANCE_EUR"
  gross_month=$((gross_month + LIABILITY_INSURANCE_EUR))

  printf '%s + operating costs %s%%\n' "$gross_month" "$OPERATING_COSTS_PERCENT"
  gross_month=$((gross_month + gross_month * OPERATING_COSTS_PERCENT / 100))

  daily_rate=$((gross_month / WORKDAYS_PER_MONTH))
  hourly_rate=$((daily_rate / WORKHOURS_PER_DAY))
  gross_year=$((gross_month * 12))
  net_year=$((net_month * 12))

  printf '%s\n' '-- NET --'
  printf 'YEAR:     %s\n' "$net_year"
  printf 'MONTH:    %s\n' "$net_month"
  printf '%s\n' '-- GROSS --'
  printf 'YEAR:     %s\n' "$gross_year"
  printf 'MONTH:    %s\n' "$gross_month"
  printf 'TJM:      %s\n' "$daily_rate"
  printf 'THM:      %s\n' "$hourly_rate"
}

main "$@"
