# ~/.gitconfig

[init]
    defaultBranch = main

[core]
    pager = less
    editor = vim -u NONE -N

[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold

[gc]
    reflogExpire = 1.month.ago

[pull]
    rebase = true

[diff]
    colorMoved = zebra
    tool = vimdiff

[merge]
    tool = vim

[commit]
    template = ~/.gitmessage

[url "git@gitlab.infra.online.net:"]
    insteadOf = https://gitlab.infra.online.net/

[mergetool "vim"]
    cmd = vim -d -c "wincmd l" -c "norm ]c" "$LOCAL" "$MERGED" "$REMOTE"

[mergetool]
    keepBackup = false

[user]
    email = cvidon@student.42.fr
    name = cvidon

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
