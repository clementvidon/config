// jsonc
[
  // =============================================================================
  // Editor groups
  // =============================================================================

  {
    "key": "shift+left",
    "command": "workbench.action.decreaseViewWidth",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "shift+right",
    "command": "workbench.action.increaseViewWidth",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "shift+up",
    "command": "workbench.action.increaseViewHeight",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "shift+down",
    "command": "workbench.action.decreaseViewHeight",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },

  // =============================================================================
  // Terminal
  // =============================================================================

  {
    "key": "ctrl+shift+`",
    "command": "workbench.action.terminal.newWithCwd",
    "args": { "cwd": "${fileDirname}" },
    "when": "editorTextFocus && resourceScheme != untitled && resourceFilename"
  },
  {
    "key": "ctrl+alt+up",
    "command": "workbench.action.increaseViewSize",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+alt+down",
    "command": "workbench.action.decreaseViewSize",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+enter",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+m",
    "command": "-editor.action.toggleTabFocusMode"
  },
  {
    "key": "ctrl+shift+m",
    "command": "-editor.action.toggleTabFocusMode"
  },
  {
    "key": "ctrl+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" },
    "when": "terminalFocus"
  },
  {
    "key": "shift+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;2D" },
    "when": "terminalFocus"
  },
  {
    "key": "shift+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;2A" },
    "when": "terminalFocus"
  },
  {
    "key": "shift+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;2C" },
    "when": "terminalFocus"
  },
  {
    "key": "shift+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;2B" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus"
  },

  // =============================================================================
  // Keep inline chat off Ctrl+i
  // =============================================================================

  {
    "key": "ctrl+i",
    "command": "-inlineChat.start"
  },
  {
    "key": "ctrl+i",
    "command": "-inlineChat.askInChat"
  }
]
